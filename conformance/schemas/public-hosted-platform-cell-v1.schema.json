{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-rfc.invalid/schemas/public-hosted-platform-cell-v1.schema.json",
  "title": "open-rfc public GitHub-hosted platform cell v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schemaVersion", "kind", "status", "candidate", "workflow",
    "runner", "runtime", "command", "compatibility", "checks"
  ],
  "properties": {
    "$schema": { "const": "../../conformance/schemas/public-hosted-platform-cell-v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "public-hosted-platform-cell" },
    "status": { "const": "passed" },
    "candidate": { "$ref": "#/$defs/candidate" },
    "workflow": { "$ref": "#/$defs/workflow" },
    "runner": { "$ref": "#/$defs/runner" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "command": { "$ref": "#/$defs/command" },
    "compatibility": { "$ref": "#/$defs/compatibility" },
    "checks": { "$ref": "#/$defs/checks" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "packageVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "filename", "sha256"],
      "properties": {
        "name": { "const": "open-rfc" },
        "version": { "$ref": "#/$defs/packageVersion" },
        "filename": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.tgz$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "releaseSetSha256", "artifact"],
      "properties": {
        "commit": { "$ref": "#/$defs/commit" },
        "releaseSetSha256": { "$ref": "#/$defs/sha256" },
        "artifact": { "$ref": "#/$defs/artifact" }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider", "repository", "workflowPath", "workflowRef", "workflowSha",
        "runId", "runAttempt", "url", "trigger"
      ],
      "properties": {
        "provider": { "const": "github-actions" },
        "repository": { "const": "marianfoo/open-rfc" },
        "workflowPath": { "const": ".github/workflows/candidate.yml" },
        "workflowRef": {
          "const": "marianfoo/open-rfc/.github/workflows/candidate.yml@refs/heads/main"
        },
        "workflowSha": { "$ref": "#/$defs/commit" },
        "runId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "runAttempt": { "type": "integer", "minimum": 1 },
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/marianfoo/open-rfc/actions/runs/[1-9][0-9]*/attempts/[1-9][0-9]*$"
        },
        "trigger": { "const": "workflow_dispatch" }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment", "label", "os", "arch", "platform", "machineArch",
        "resolvedImage", "resolvedImageVersion", "imageMetadataSource"
      ],
      "properties": {
        "environment": { "const": "github-hosted" },
        "label": { "const": "ubuntu-24.04" },
        "os": { "const": "Linux" },
        "arch": { "const": "X64" },
        "platform": { "const": "linux" },
        "machineArch": { "const": "x64" },
        "resolvedImage": { "const": "ubuntu24" },
        "resolvedImageVersion": {
          "type": "string",
          "pattern": "^20[2-9][0-9][0-1][0-9][0-3][0-9]\\.[0-9]{1,4}\\.[0-9]{1,3}$"
        },
        "imageMetadataSource": { "const": "github-runner-image-environment" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestedNode", "nodeMajor", "nodeVersion"],
      "properties": {
        "requestedNode": { "enum": ["22", "24"] },
        "nodeMajor": { "enum": [22, 24] },
        "nodeVersion": {
          "type": "string",
          "pattern": "^v(?:22|24)\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "startedAt", "finishedAt", "durationMs", "argvSha256", "resultSha256", "exitCode"],
      "properties": {
        "id": { "const": "packed-compatibility-v1" },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "finishedAt": { "$ref": "#/$defs/timestamp" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "argvSha256": { "$ref": "#/$defs/sha256" },
        "resultSha256": { "$ref": "#/$defs/sha256" },
        "exitCode": { "const": 0 }
      }
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "cjs", "esm", "types", "cleanInstall", "dependencyCount", "packageCopies"],
      "properties": {
        "alias": { "enum": ["@sap-rfc/node-rfc-library", "node-rfc"] },
        "cjs": { "const": true },
        "esm": { "const": true },
        "types": { "const": true },
        "cleanInstall": { "const": true },
        "dependencyCount": { "const": 1 },
        "packageCopies": { "const": 1 }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicationMode", "artifactFileCount", "artifactSize", "consumers", "sdkFree",
        "externalNetworkRequired", "networkGuard", "secretFreeChildEnvironment", "suppliedArtifact"
      ],
      "properties": {
        "publicationMode": { "const": "public-license-preflight" },
        "artifactFileCount": { "type": "integer", "minimum": 1 },
        "artifactSize": { "type": "integer", "minimum": 1 },
        "consumers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/consumer" }
        },
        "sdkFree": { "const": true },
        "externalNetworkRequired": { "const": false },
        "networkGuard": { "const": true },
        "secretFreeChildEnvironment": { "const": true },
        "suppliedArtifact": { "const": true }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sameArtifact", "cleanInstall", "esm", "cjs", "types", "aliases", "sdkFree", "offline"],
      "properties": {
        "sameArtifact": { "const": true },
        "cleanInstall": { "const": true },
        "esm": { "const": true },
        "cjs": { "const": true },
        "types": { "const": true },
        "aliases": { "const": true },
        "sdkFree": { "const": true },
        "offline": { "const": true }
      }
    }
  }
}
