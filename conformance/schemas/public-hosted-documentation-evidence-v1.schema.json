{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-rfc.invalid/schemas/public-hosted-documentation-evidence-v1.schema.json",
  "title": "open-rfc public hosted documentation evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schemaVersion", "kind", "candidate", "releaseSet",
    "workflow", "runner", "runtime", "dependencyClosure", "source", "site",
    "checks", "command", "conclusion"
  ],
  "properties": {
    "$schema": {
      "const": "../../conformance/schemas/public-hosted-documentation-evidence-v1.schema.json"
    },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "public-hosted-documentation-evidence" },
    "candidate": { "$ref": "#/$defs/candidate" },
    "releaseSet": { "$ref": "#/$defs/releaseSet" },
    "workflow": { "$ref": "#/$defs/workflow" },
    "runner": { "$ref": "#/$defs/runner" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "dependencyClosure": { "$ref": "#/$defs/dependencyClosure" },
    "source": { "$ref": "#/$defs/source" },
    "site": { "$ref": "#/$defs/site" },
    "checks": { "$ref": "#/$defs/checks" },
    "command": { "$ref": "#/$defs/command" },
    "conclusion": { "const": "success" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "commit", "tarballSha256"],
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "commit": { "$ref": "#/$defs/commit" },
        "tarballSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "version", "filename", "sha256", "integrity", "bytes",
        "unpackedBytes", "fileCount", "archiveInventorySha256"
      ],
      "properties": {
        "name": { "const": "open-rfc" },
        "version": { "$ref": "#/$defs/version" },
        "filename": { "type": "string", "pattern": "^open-rfc-[0-9A-Za-z._-]+\\.tgz$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "integrity": {
          "type": "string",
          "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$"
        },
        "bytes": { "type": "integer", "minimum": 1 },
        "unpackedBytes": { "type": "integer", "minimum": 1 },
        "fileCount": { "type": "integer", "minimum": 1 },
        "archiveInventorySha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "releaseSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "releaseSetSha256", "connector"],
      "properties": {
        "commit": { "$ref": "#/$defs/commit" },
        "releaseSetSha256": { "$ref": "#/$defs/sha256" },
        "connector": { "$ref": "#/$defs/artifact" }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider", "repository", "workflowPath", "workflowRef", "workflowSha",
        "runId", "runAttempt", "url", "trigger", "startedAt", "finishedAt",
        "conclusion"
      ],
      "properties": {
        "provider": { "const": "github-actions" },
        "repository": { "const": "marianfoo/open-rfc" },
        "workflowPath": { "const": ".github/workflows/candidate.yml" },
        "workflowRef": {
          "const": "marianfoo/open-rfc/.github/workflows/candidate.yml@refs/heads/main"
        },
        "workflowSha": { "$ref": "#/$defs/commit" },
        "runId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "runAttempt": { "type": "integer", "minimum": 1 },
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/marianfoo/open-rfc/actions/runs/[1-9][0-9]*/attempts/[1-9][0-9]*$"
        },
        "trigger": { "const": "workflow_dispatch" },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "finishedAt": { "$ref": "#/$defs/timestamp" },
        "conclusion": { "const": "success" }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment", "label", "os", "arch", "platform", "machineArch",
        "resolvedImage", "resolvedImageVersion", "imageMetadataSource"
      ],
      "properties": {
        "environment": { "const": "github-hosted" },
        "label": { "const": "ubuntu-24.04" },
        "os": { "const": "Linux" },
        "arch": { "const": "X64" },
        "platform": { "const": "linux" },
        "machineArch": { "const": "x64" },
        "resolvedImage": { "const": "ubuntu24" },
        "resolvedImageVersion": {
          "type": "string",
          "pattern": "^20[2-9][0-9][0-1][0-9][0-3][0-9]\\.[0-9]{1,4}\\.[0-9]{1,3}$"
        },
        "imageMetadataSource": { "const": "github-runner-image-environment" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeVersion", "pythonImplementation", "pythonVersion"],
      "properties": {
        "nodeVersion": {
          "type": "string",
          "pattern": "^v24\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "pythonImplementation": { "const": "CPython" },
        "pythonVersion": { "const": "3.13.14" }
      }
    },
    "dependencyClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "sha256", "count", "requireHashes", "onlyBinary", "pipCheck",
        "pipVersion", "pipBoundToRuntime", "installedCount", "installedSha256"
      ],
      "properties": {
        "path": { "const": "requirements-docs.txt" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "count": { "const": 29 },
        "requireHashes": { "const": true },
        "onlyBinary": { "const": true },
        "pipCheck": { "const": true },
        "pipVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$" },
        "pipBoundToRuntime": { "const": true },
        "installedCount": { "const": 29 },
        "installedSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm", "commit", "fileCount", "sha256",
        "configurationSha256", "requirementsSha256"
      ],
      "properties": {
        "algorithm": { "const": "candidate-documentation-source-sha256-v1" },
        "commit": { "$ref": "#/$defs/commit" },
        "fileCount": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "configurationSha256": { "$ref": "#/$defs/sha256" },
        "requirementsSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files", "pages", "bytes", "sha256", "deterministic",
        "packageVersion", "nodeEngine"
      ],
      "properties": {
        "files": { "type": "integer", "minimum": 14 },
        "pages": { "type": "integer", "minimum": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "deterministic": { "const": true },
        "packageVersion": { "$ref": "#/$defs/version" },
        "nodeEngine": { "type": "string", "minLength": 1 }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateVerifiedBeforeAfter", "packageManifestFromArtifact",
        "sourceInventory", "privateReferencesAbsent", "contentSecurityPolicy",
        "links", "deterministic"
      ],
      "properties": {
        "candidateVerifiedBeforeAfter": { "const": true },
        "packageManifestFromArtifact": { "const": true },
        "sourceInventory": { "const": true },
        "privateReferencesAbsent": { "const": true },
        "contentSecurityPolicy": { "const": true },
        "links": { "const": true },
        "deterministic": { "const": true }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "startedAt", "finishedAt", "durationMs", "argvSha256", "exitCode"],
      "properties": {
        "id": { "const": "hosted-documentation-site-v1" },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "finishedAt": { "$ref": "#/$defs/timestamp" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "argvSha256": { "$ref": "#/$defs/sha256" },
        "exitCode": { "const": 0 }
      }
    }
  }
}
