{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-rfc.invalid/schemas/public-hosted-platform-evidence-v1.schema.json",
  "title": "open-rfc public hosted platform evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "kind", "status", "candidate", "workflow", "cells", "checks"],
  "properties": {
    "$schema": { "const": "../../conformance/schemas/public-hosted-platform-evidence-v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "public-hosted-platform-evidence" },
    "status": { "const": "passed" },
    "candidate": { "$ref": "#/$defs/candidate" },
    "workflow": { "$ref": "#/$defs/workflow" },
    "cells": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/cell" }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateStable", "sameArtifact", "sameWorkflowRun", "completeNodeMatrix", "sdkFree", "offline", "aliases"],
      "properties": {
        "candidateStable": { "const": true },
        "sameArtifact": { "const": true },
        "sameWorkflowRun": { "const": true },
        "completeNodeMatrix": { "const": true },
        "sdkFree": { "const": true },
        "offline": { "const": true },
        "aliases": { "const": true }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "releaseSetSha256", "artifact"],
      "properties": {
        "commit": { "$ref": "#/$defs/commit" },
        "releaseSetSha256": { "$ref": "#/$defs/sha256" },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "filename", "sha256"],
          "properties": {
            "name": { "const": "open-rfc" },
            "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
            "filename": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.tgz$" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider", "repository", "workflowPath", "workflowRef", "workflowSha",
        "runId", "runAttempt", "url", "trigger", "startedAt", "finishedAt"
      ],
      "properties": {
        "provider": { "const": "github-actions" },
        "repository": { "const": "marianfoo/open-rfc" },
        "workflowPath": { "const": ".github/workflows/candidate.yml" },
        "workflowRef": {
          "const": "marianfoo/open-rfc/.github/workflows/candidate.yml@refs/heads/main"
        },
        "workflowSha": { "$ref": "#/$defs/commit" },
        "runId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "runAttempt": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "pattern": "^https://github\\.com/marianfoo/open-rfc/actions/runs/[1-9][0-9]*/attempts/[1-9][0-9]*$" },
        "trigger": { "const": "workflow_dispatch" },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "finishedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "startedAt", "finishedAt", "durationMs", "argvSha256", "resultSha256", "exitCode"],
      "properties": {
        "id": { "const": "packed-compatibility-v1" },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "finishedAt": { "$ref": "#/$defs/timestamp" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "argvSha256": { "$ref": "#/$defs/sha256" },
        "resultSha256": { "$ref": "#/$defs/sha256" },
        "exitCode": { "const": 0 }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicationMode", "artifactFileCount", "artifactSize", "consumers", "sdkFree",
        "externalNetworkRequired", "networkGuard", "secretFreeChildEnvironment", "suppliedArtifact"
      ],
      "properties": {
        "publicationMode": { "const": "public-license-preflight" },
        "artifactFileCount": { "type": "integer", "minimum": 1 },
        "artifactSize": { "type": "integer", "minimum": 1 },
        "consumers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["alias", "cjs", "esm", "types", "cleanInstall", "dependencyCount", "packageCopies"],
            "properties": {
              "alias": { "enum": ["@sap-rfc/node-rfc-library", "node-rfc"] },
              "cjs": { "const": true },
              "esm": { "const": true },
              "types": { "const": true },
              "cleanInstall": { "const": true },
              "dependencyCount": { "const": 1 },
              "packageCopies": { "const": 1 }
            }
          }
        },
        "sdkFree": { "const": true },
        "externalNetworkRequired": { "const": false },
        "networkGuard": { "const": true },
        "secretFreeChildEnvironment": { "const": true },
        "suppliedArtifact": { "const": true }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinate", "filename", "sha256", "nodeVersion", "runnerImageVersion", "command", "compatibility"],
      "properties": {
        "coordinate": { "enum": ["22:linux:x64", "24:linux:x64"] },
        "filename": { "type": "string", "pattern": "^public-platform-node(?:22|24)-linux-x64\\.v1\\.json$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "nodeVersion": { "type": "string", "pattern": "^v(?:22|24)\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
        "runnerImageVersion": { "type": "string", "pattern": "^20[2-9][0-9][0-1][0-9][0-3][0-9]\\.[0-9]{1,4}\\.[0-9]{1,3}$" },
        "command": { "$ref": "#/$defs/command" },
        "compatibility": { "$ref": "#/$defs/compatibility" }
      }
    }
  }
}
