{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-rfc.invalid/schemas/release-history-secret-admissions-v1.schema.json",
  "title": "open-rfc reviewed reachable-history secret admission ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "policy",
    "objectFormat",
    "approval",
    "admissions"
  ],
  "properties": {
    "$schema": {
      "const": "./schemas/release-history-secret-admissions-v1.schema.json"
    },
    "schemaVersion": { "const": 1 },
    "policy": { "const": "exact-git-blob-path-pattern-v1" },
    "objectFormat": { "enum": ["sha1", "sha256"] },
    "approval": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reviewedBy", "reviewedAt", "reviewReference"],
          "properties": {
            "status": { "const": "draft" },
            "reviewedBy": { "type": "null" },
            "reviewedAt": { "type": "null" },
            "reviewReference": { "type": "null" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reviewedBy", "reviewedAt", "reviewReference"],
          "properties": {
            "status": { "const": "accepted" },
            "reviewedBy": { "type": "string", "minLength": 3 },
            "reviewedAt": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            },
            "reviewReference": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "admissions": {
      "type": "array",
      "maxItems": 512,
      "items": { "$ref": "#/$defs/admission" }
    }
  },
  "$defs": {
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectId",
        "objectSha256",
        "path",
        "patternId",
        "classification",
        "rationale"
      ],
      "properties": {
        "objectId": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "objectSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "path": { "type": "string", "minLength": 1 },
        "patternId": {
          "enum": [
            "pattern-1",
            "pattern-2",
            "pattern-3",
            "pattern-4",
            "pattern-5",
            "pattern-6",
            "pattern-7",
            "pattern-8",
            "pattern-9",
            "pattern-10",
            "pattern-11",
            "pattern-12",
            "pattern-13",
            "pattern-14"
          ]
        },
        "classification": {
          "enum": ["unreviewed", "synthetic-fixture"]
        },
        "rationale": { "type": "string", "minLength": 12 }
      }
    }
  }
}
