{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-rfc.invalid/schemas/api-export-manifest-v1.schema.json",
  "title": "Package entrypoint export inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "module", "expectedExportCount", "exports"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "module": {
      "const": "open-rfc"
    },
    "expectedExportCount": { "type": "integer", "minimum": 1 },
    "exports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "stability", "reason", "capabilityIds"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
          "stability": {
            "enum": ["stable", "experimental", "internal", "removeBefore1"]
          },
          "reason": { "type": "string", "minLength": 1 },
          "capabilityIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^cap\\.[a-z0-9.-]+$" }
          }
        }
      }
    }
  }
}
